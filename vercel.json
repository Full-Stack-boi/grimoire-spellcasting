{
  "functions": {
    "api/ddb.ts": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/combat-badges/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/background.html", "destination": "/background.html" },
    { "source": "/api/ddb/:path*", "destination": "/api/ddb" },
    { "source": "/api/ddb-monsters/:path*", "destination": "/api/ddb" },
    { "source": "/((?!assets|combat-badges|background\\.html|[^/]+\\.[^/]+).*)", "destination": "/index.html" }
  ]
}
